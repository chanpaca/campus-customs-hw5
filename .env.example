# ---------------------------------------------------------------------------
# Campus Customs (HW5) — environment template
#
# Copy this file to .env and fill in your own values:
#     cp .env.example .env
#
# The real .env is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# --- LLM gateway (required) -------------------------------------------------
# Portkey is an OpenAI-compatible gateway. The five-agent team reaches
# gpt-6-luna through it. Without a valid key the agents cannot run.
PORTKEY_API_KEY=your_key_here

# The only model this team runs on. backend/agents.py pins "gpt-6-luna" in code
# and refuses to start if this is set to anything else, so a stale value from an
# earlier assignment cannot silently redirect the team to a different model.
PORTKEY_MODEL=gpt-6-luna

# Optional — defaults to Portkey's public endpoint if unset.
# PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional — set a Portkey virtual key if your account uses one.
# PORTKEY_VIRTUAL_KEY=your_virtual_key_here


# --- Database (optional) ----------------------------------------------------
# The MCP server resolves data/campus_customs_new.db relative to the project
# root. Set this to point the tools at a different file.
# CAMPUS_CUSTOMS_DB=/absolute/path/to/campus_customs_new.db


# --- Frontend (optional) ----------------------------------------------------
# The Vite dev server proxies /api to http://127.0.0.1:8000 by default.
# Put this in frontend/.env.local to point at a backend on another port.
# VITE_API_TARGET=http://127.0.0.1:8000
